# /etc/muxplex-agent-proxy.env             mode 0600, owned root:root
#
# Environment muxplex itself reads, to find and authenticate to the chat
# sidecar. Loaded via the drop-in at
#   /etc/systemd/system/muxplex.service.d/agent-proxy.conf
#
#   [Service]
#   EnvironmentFile=/etc/muxplex-agent-proxy.env
#
# See docs/AGENT_CHAT_SETUP.md §5.
#
# INSTALL:
#   sudo install -m 0600 -o root -g root \
#     docs/agent-chat-sidecar/etc/muxplex-agent-proxy.env.example \
#     /etc/muxplex-agent-proxy.env
#   sudoedit /etc/muxplex-agent-proxy.env
#
# BEFORE `systemctl restart muxplex`, read AGENTS.md -> "Two ways to destroy
# every live tmux session on this host", and confirm the unit resolves
# KillMode=process. Under the default KillMode a restart can SIGKILL the tmux
# server muxplex parented, taking every live session with it. This has
# happened on a real box: 44 sessions, one timestamp.

# Where the sidecar listens. Read by muxplex/main.py as _AGENT_PROXY_URL;
# this default is also main.py's own fallback when the variable is unset.
#
# Pointing this off-box is mechanically possible and NOT RECOMMENDED: the
# sidecar binds loopback and is fenced off from every other local service on
# purpose. Remoting it means publishing an agent endpoint onto a network the
# fence argument was never built against. Treat it as a design change.
AMPLIFIER_AGENT_URL=http://127.0.0.1:9099

# MUST be byte-identical to AMPLIFIER_AGENT_HTTP_API_KEY in
# /etc/amplifier-agent-http-aasvc.env.
#
# If this is unset, the proxy route does NOT fail obscurely -- it returns
#   503 {"error":{"message":"Agent proxy is not configured on this server
#                            (AMPLIFIER_AGENT_BEARER_TOKEN unset)"}}
# and the panel renders that text. A 401 "Invalid API key" instead means the
# variable IS set but disagrees with the sidecar's copy.
AMPLIFIER_AGENT_BEARER_TOKEN=REPLACE_ME_same_value_as_AMPLIFIER_AGENT_HTTP_API_KEY
