# /etc/amplifier-agent-http-aasvc.env      mode 0600, owned aa-svc:aa-svc
#
# Environment for amplifier-agent-http.service (the chat sidecar).
# See docs/AGENT_CHAT_SETUP.md §3.4 for the walkthrough.
#
# INSTALL:
#   sudo install -m 0600 -o aa-svc -g aa-svc \
#     docs/agent-chat-sidecar/etc/amplifier-agent-http-aasvc.env.example \
#     /etc/amplifier-agent-http-aasvc.env
#   sudoedit /etc/amplifier-agent-http-aasvc.env
#
# THIS FILE CARRIES TWO SECRETS. The .example shipped in the repo carries
# placeholders only. Never commit the filled-in version, and never relax the
# 0600 -- the host-config file (below) is world-readable precisely so that
# this one does not have to be.

# --- wire ------------------------------------------------------------------
# Loopback ONLY, by design -- same posture as ttyd. The sidecar is never on
# the LAN. Changing this is a design change, not a config change: the network
# fence and the "agent holds no muxplex credential" argument both assume it.
AMPLIFIER_AGENT_HTTP_BIND=127.0.0.1
AMPLIFIER_AGENT_HTTP_PORT=9099

# --- session bucket --------------------------------------------------------
# Where per-session state lands:
#   ~aa-svc/.amplifier-agent/state/workspaces/<workspace>/sessions/<id>/
# Transcripts persist here unconditionally, with no retention window. Known
# and accepted for the POC -- see docs/AGENT_CHAT_SETUP.md §7.
AMPLIFIER_AGENT_HTTP_WORKSPACE=muxplex-chat-poc

# --- model id --------------------------------------------------------------
# NOTE: this does NOT choose which model runs, and does not constrain the
# served list. Models are enumerated live from the configured provider at
# startup and published at GET /v1/models; this value is the id the POC's own
# single-model path advertises and is typically absent from that list.
#
# The model that actually runs is the one the PANEL sends (hardcoded in
# muxplex/frontend/chat.js). It must appear in GET /v1/models or every turn
# returns 400 unknown_model. See docs/AGENT_CHAT_SETUP.md §3.5.
AMPLIFIER_AGENT_HTTP_MODEL_ID=amplifier

# Optional: human-readable name surfaced in models.data[*].name.
#AMPLIFIER_AGENT_HTTP_MODEL_NAME=Amplifier

# --- host config -----------------------------------------------------------
# Path ONLY -- there is no inline form. When this file declares a `providers`
# block, that block is AUTHORITATIVE and provider env vars are not consulted
# for provider selection at all. Omit this variable (or drop the block) to let
# credentials auto-enable providers instead. docs/AGENT_CHAT_SETUP.md §3.1.
AMPLIFIER_AGENT_HTTP_CONFIG_PATH=/etc/amplifier-agent-host-config.json

# --- process environment ---------------------------------------------------
PATH=/home/aa-svc/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/home/aa-svc

# ===========================================================================
# SECRETS -- replace both placeholders. Do not commit the result.
# ===========================================================================

# Shared bearer muxplex presents to the sidecar. Generate fresh:
#   openssl rand -hex 32
# MUST be byte-identical to AMPLIFIER_AGENT_BEARER_TOKEN in
# /etc/muxplex-agent-proxy.env. A mismatch surfaces as HTTP 401
# {"error":{"message":"Invalid API key"}}.
#
# Scoped to exactly one thing -- "muxplex may call the agent's chat API" --
# and grants nothing in the other direction. Never reuse the federation key.
AMPLIFIER_AGENT_HTTP_API_KEY=REPLACE_ME_openssl_rand_hex_32

# Provider credential. Set the one matching your host-config `providers`
# block (or, on the auto-enable path, the provider you want):
#
#   Anthropic       ANTHROPIC_API_KEY
#   OpenAI          OPENAI_API_KEY
#   Azure OpenAI    AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT
#                   (or AZURE_OPENAI_AD_TOKEN)
#   Ollama          OLLAMA_HOST
#   GitHub Copilot  GITHUB_TOKEN          (environment only -- no credential
#                                          store path for this provider)
#
# Alternative to any of these: `sudo -u aa-svc -H amplifier-agent auth set
# <provider> <key>`, which writes ~aa-svc/.amplifier-agent/credentials.json
# at mode 0600.
#
# A MISSING OR INVALID KEY IS A STARTUP FAILURE, NOT A RUNTIME ONE: the
# sidecar exits 2 rather than serving zero models, and the panel then shows a
# turn that ends with nothing. Check `journalctl -u amplifier-agent-http`
# first, always. docs/AGENT_CHAT_SETUP.md §7.
ANTHROPIC_API_KEY=REPLACE_ME_provider_api_key
