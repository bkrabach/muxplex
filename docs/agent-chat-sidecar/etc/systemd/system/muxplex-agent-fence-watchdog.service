[Unit]
Description=Re-prove the agent-sidecar network fence; stop the sidecar if it has fallen
Documentation=file:///opt/muxplex/docs/AGENT_CHAT_SIDECAR.md

[Service]
Type=oneshot
# `watchdog` verifies and, on failure, stops BOTH the sidecar (immediately,
# explicitly) and the fence unit (so its state stops claiming a protection
# that is not there, and BindsTo= holds the sidecar down independently of
# this script having succeeded at anything).
#
# Recovery is deliberately not automatic: bringing the sidecar back requires
# starting the fence unit, which re-applies AND re-proves the rules. There is
# no path that resumes serving without the fence being demonstrated first.
ExecStart=/usr/local/sbin/muxplex-agent-fence watchdog
