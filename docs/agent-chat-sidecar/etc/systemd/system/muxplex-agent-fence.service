[Unit]
Description=Network fence isolating the amplifier-agent sidecar from muxplex
Documentation=file:///opt/muxplex/docs/AGENT_CHAT_SIDECAR.md
# This unit is the reboot persistence. There is no iptables-persistent here;
# instead the fence is re-derived and RE-PROVEN on every boot, which is
# strictly better -- a restored ruleset that no longer blocks anything would
# still restore silently, whereas this fails.
After=network-pre.target network.target muxplex.service
Wants=network-pre.target
Before=amplifier-agent-http.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/muxplex-agent-fence apply
# The fence is not "applied" until it has been PROVEN, from the sidecar's own
# UID, against a live muxplex. 60s of slack for muxplex to finish binding on
# a cold boot; after that this unit fails, and Requires=/BindsTo= on the
# sidecar means the sidecar does not start.
ExecStartPost=/usr/local/sbin/muxplex-agent-fence verify 60
ExecReload=/usr/local/sbin/muxplex-agent-fence apply

[Install]
WantedBy=multi-user.target
