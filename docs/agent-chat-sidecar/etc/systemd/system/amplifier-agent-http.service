# /etc/systemd/system/amplifier-agent-http.service
#
# The amplifier-agent chat-completions sidecar behind muxplex's agent panel.
# See docs/AGENT_CHAT_SETUP.md §4 and docs/AGENT_CHAT_SIDECAR.md §5.
#
# This unit is deliberately minimal. The security properties do NOT live here
# -- they live in the drop-in at amplifier-agent-http.service.d/fence.conf,
# which adds Requires=/BindsTo=/ExecStartPre= against the network fence. Both
# files install together:
#
#   sudo install -m 0644 etc/systemd/system/amplifier-agent-http.service /etc/systemd/system/
#   sudo cp -a  etc/systemd/system/.                                     /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# Installing this unit WITHOUT the drop-in yields a sidecar that starts
# unfenced. Do not do that.

[Unit]
Description=amplifier-agent HTTP chat-completions face (muxplex chat sidecar, isolated user)
After=network.target

[Service]
Type=simple

# Its own unprivileged user, and this is load-bearing rather than hygiene:
# the fence's iptables OUTPUT rule matches on this user's UID. Changing the
# user here without updating AA_USER in /etc/muxplex-agent-fence.conf leaves
# the sidecar running with no fence at all -- which `verify` catches, and
# BindsTo= then acts on, but only because the two were kept in step.
User=aa-svc
Group=aa-svc

# Mode 0600, owned aa-svc:aa-svc. Carries both secrets (the provider API key
# and the shared bearer). See amplifier-agent-http-aasvc.env.example.
EnvironmentFile=/etc/amplifier-agent-http-aasvc.env

ExecStart=/home/aa-svc/.local/bin/amplifier-agent serve chat-completions
WorkingDirectory=/home/aa-svc

# A missing or invalid provider key is a STARTUP failure (exit 2), not a
# runtime one -- the sidecar refuses to serve zero models. With this policy
# systemd restart-loops it, so `systemctl is-active` may read "activating"
# rather than a clean "failed". `journalctl -u amplifier-agent-http` carries
# the precise reason; the browser does not. docs/AGENT_CHAT_SETUP.md §7.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
